# Copy to .env and edit. Every value below is optional: the project runs offline,
# with no key, using the generated corpus and the extractive answerer.
#
#   cp .env.example .env

# --- corpus -----------------------------------------------------------------
# true never touches the network. Set false to collect from the live sources.
MINING_OFFLINE=true
MINING_WINDOW_DAYS=30
MINING_MIN_ITEMS_PER_SOURCE=200

# --- storage ----------------------------------------------------------------
MINING_INDEX_DIR=.index
MINING_CACHE_DIR=.cache
MINING_CACHE_ENABLED=true
MINING_CACHE_TTL=3600

# --- retrieval --------------------------------------------------------------
# hashing (deterministic, offline) | openai (any OpenAI-compatible /embeddings)
MINING_EMBEDDER=hashing
MINING_EMBEDDING_DIM=512
# numpy (exact cosine, no service) | chroma (requires the [chroma] extra)
MINING_VECTOR_BACKEND=numpy
MINING_TOP_K=5
# Leave unset to pick the blend from the embedder (0.6 hashing / 0.35 learned).
# MINING_LEXICAL_WEIGHT=0.6
MINING_TITLE_WEIGHT=0.15

# --- serving ----------------------------------------------------------------
MINING_SERVE_HOST=127.0.0.1
MINING_SERVE_PORT=8000
MINING_LOG_LEVEL=INFO
MINING_LOG_JSON=false
# Exposes POST /ingest, which rewrites the index. Off unless you want it.
MINING_ALLOW_INGEST_ENDPOINT=false

# --- optional: LLM answer synthesis ----------------------------------------
# Without a key, answers are assembled extractively from the retrieved evidence.
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=1024

# --- optional: real embeddings ---------------------------------------------
# Requires MINING_EMBEDDER=openai and a rebuild: the vector dimension changes.
# LLM_EMBEDDING_API_KEY=
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
